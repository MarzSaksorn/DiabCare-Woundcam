# Local development configuration only.
# Copy this file to .env and replace every placeholder before starting the app.
#
# ==========================================================================
# IMPORTANT: USE THE SUPABASE SESSION POOLER URL ONLY
# ==========================================================================
#
# Use Supabase Dashboard -> Connect -> Session pooler.
# Do NOT use the direct db.<project-ref>.supabase.co connection here.
# The direct database host may resolve to IPv6 and fail from this Docker host.
# The application expects the IPv4-compatible pooler host on port 5432.
#
# Correct shape:
# postgresql://postgres.<PROJECT-REF>:[PASSWORD]@[POOLER-HOST]:5432/postgres
#
# Stop and recreate Docker after changing this value:
# docker compose down && docker compose up --build -d --force-recreate
#
# ==========================================================================

NODE_ENV=development
PORT=3000
LOCAL_AUTH_BYPASS=true

# Supabase Dashboard -> Connect -> Session pooler (IPv4-compatible) ONLY.
# Use the exact pooler host/region shown by Supabase; URL-encode reserved
# characters in the database password.
SUPABASE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres

# Optional PEM CA chain for verified Supabase/PostgreSQL TLS in production.
DATABASE_SSL_CA=

# DATABASE_URL is platform-managed in WebDev. Leave it unset locally.
DATABASE_URL=

# Required by the local session-cookie implementation.
JWT_SECRET=replace-with-a-long-random-development-secret

# Optional when using the local development bypass.
VITE_APP_ID=local-development
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=local-development-user
OWNER_NAME=Local Clinician
