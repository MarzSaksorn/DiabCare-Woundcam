# Local development configuration only.
# Copy this file to .env and replace every placeholder before starting the app.

NODE_ENV=development
PORT=3000
LOCAL_AUTH_BYPASS=true

# Supabase Dashboard -> Connect -> Direct connection (IPv6).
# URL-encode reserved characters in the database password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gpxgyvjoamwyrbswljyj.supabase.co:5432/postgres

# Required by the local session-cookie implementation.
JWT_SECRET=replace-with-a-long-random-development-secret

# Optional when using the local development bypass.
VITE_APP_ID=local-development
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=local-development-user
OWNER_NAME=Local Clinician
